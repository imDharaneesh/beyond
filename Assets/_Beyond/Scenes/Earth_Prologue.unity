  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: aec1ad371461c9c42960db4bddc918b6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Beyond.Runtime::Beyond.Interaction.JournalNote
  title: Camp Log - Radio
  body: "Day 22.\n\nHale stripped the radio for his receiver experiment. To get the transmitter working again you need:\n\n  -  3 x Copper Wire (spools were packed in the supply crates)\n  -  1 x Battery Cell (Ilves hid the spare somewhere)\n  -  1 x Radio Circuit Board (Hale keeps it in his case, in the tent)\n\nHale and Ilves left at dawn toward the coordinates. I'm staying with the camp.\n\n-  R. Okafor"
